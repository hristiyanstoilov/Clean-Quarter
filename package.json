{
  "name": "clean-quarter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "playwright": "playwright test",
    "playwright:update": "playwright test --update-snapshots",
    "lhci": "lhci autorun"
  },
  "lint-staged": {
    "src/**/*.{js,css,html}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@vitest/coverage-v8": "^0.34.6",
    "axe-core": "^4.11.1",
    "cypress": "^15.10.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "terser": "^5.46.0",
    "vite": "^5.4.21",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  }
}
