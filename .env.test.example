# Test Database Configuration
# Copy this file to .env.test and fill in your test database credentials

# Set to true to enable database integration tests
TEST_WITH_DB=true

# Supabase Test Project Credentials
# IMPORTANT: Use a SEPARATE test project, NOT your production database!
VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-anon-key-here

# Test Database Setup Instructions:
# 1. Go to https://supabase.com/dashboard
# 2. Create a NEW project specifically for testing (e.g., "clean-quarter-test")
# 3. Run the same migrations as your main project
# 4. Copy the URL and anon key from Project Settings -> API
# 5. Rename this file to .env.test
# 6. Run: TEST_WITH_DB=true npm test

# WARNING: Test database will have data created/modified/deleted during tests!
# Never use your production database for testing!
